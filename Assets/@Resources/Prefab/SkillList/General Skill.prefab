  m_Text: "\uC624\uB798\uC804\uBD80\uD130 \uB9C8\uBB3C\uB4E4\uACFC\uC758 \uAD50\uAC10\uC740\n\uC808\uB300\uC801\uC73C\uB85C
    \uBD88\uAC00\uB2A5\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC838 \uC654\uC5C8\uC2B5\uB2C8\uB2E4.<size=2>\n\n</size>\uD558\uC9C0\uB9CC
