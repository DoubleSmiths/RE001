  m_Text: "\uB9C8\uBB3C\uB4E4\uC774 \uB2F9\uC2E0\uC5D0\uAC8C \uAD00\uC2EC\uC744 \uBCF4\uC774\uB2E4\uAC00\uB3C4\n\uB2F9\uC2E0\uC5D0\uAC8C
    \uD765\uBBF8\uB97C \uBCF4\uC774\uB294 \uB9C8\uBB3C\uB4E4\uC774 \uC774\uBBF8\n\uB108\uBB34
    \uB9CE\uC73C\uBA74 \uADF8\uB4E4\uC740 \uD765\uBBF8\uB97C \uC783\uACE0 \uB2E4\uC2DC
    \uB3CC\uC544\uAC11\uB2C8\uB2E4.<size=2>\n\n</size>\uB2F9\uC2E0\uC758 \uC555\uB3C4\uC801\uC778
